# Every setting in utils/config.py can be overridden with an AI_ENGINE_-prefixed
# environment variable. Copy to .env for local overrides (.env is gitignored),
# or set these in the hosting platform's dashboard.
#
# All values below are the built-in defaults - the application runs correctly
# with none of them set.

# --- CORS -------------------------------------------------------------------
# JSON list. Add the deployed frontend origin here in production, e.g.
#   AI_ENGINE_ALLOWED_ORIGINS=["https://qsfi.example.app"]
# Never use "*": the API sends credentials, which browsers refuse alongside a
# wildcard origin.
AI_ENGINE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Covers Vite's auto-incremented dev ports (5173-5199). Set to an empty string
# in production if localhost origins should not be able to call the API.
AI_ENGINE_ALLOWED_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):51[7-9]\d$

# --- Storage ----------------------------------------------------------------
# Relative paths resolve against the process working directory (ai-engine/).
# In production point these at a mounted persistent disk using absolute paths,
# e.g. AI_ENGINE_PROCESSED_DIR=/var/data/processed
#
# PROCESSED_DIR is the one that matters most: /history and /compare/latest read
# every JSON file in it, so on ephemeral storage that history is lost on each
# restart or redeploy.
AI_ENGINE_UPLOAD_DIR=uploads
AI_ENGINE_PROCESSED_DIR=processed

# --- Uploads ----------------------------------------------------------------
AI_ENGINE_MAX_UPLOAD_SIZE_BYTES=10485760
